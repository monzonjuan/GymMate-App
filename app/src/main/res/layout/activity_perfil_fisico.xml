<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gym_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perfil_titulo"
            android:textColor="@color/gym_text_primary"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perfil_subtitulo"
            android:textColor="@color/gym_text_secondary"
            android:textSize="16sp"
            android:layout_marginTop="4dp" />

        <!-- SECCIÓN: DATOS BÁSICOS -->
        <TextView
            android:id="@+id/lblDatosBasicos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perfil_datos_basicos"
            android:textColor="@color/gym_text_primary"
            android:textSize="18sp"
            android:layout_marginTop="28dp" />

        <!-- FILA DE 3 CAMPOS (resuelta: fijate el 0dp + weight) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.GymMate.TextInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/perfil_edad">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEdad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.GymMate.TextInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/perfil_peso"
                android:layout_marginStart="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPeso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.GymMate.TextInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/perfil_altura"
                android:layout_marginStart="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAltura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
        <TextView
            android:id="@+id/lblPerfilNivel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perfil_nivel"
            android:textColor="@color/gym_text_primary"
            android:textSize="18sp"
            android:layout_marginTop="28dp" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:selectionRequired="true"
            app:singleSelection="true"
            >


            <com.google.android.material.chip.Chip
                android:id="@+id/chipPrincipiante"
                style="@style/Widget.GymMate.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil_principiante"
                />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipIntermedio"
                style="@style/Widget.GymMate.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil_intermedio"
                />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAvanzado"
                style="@style/Widget.GymMate.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil_avanzado" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/lblDiasDisponibles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perfil_dias"
            android:textColor="@color/gym_text_primary"
            android:textSize="18sp"
            android:layout_marginTop="28dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderDias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:valueFrom="1"
            android:valueTo="7"
            android:stepSize="1"
            android:value="4"
            app:labelBehavior="visible"
            app:tickVisible="true" />

        <TextView
            android:id="@+id/lblObjetivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perfil_objetivo"
            android:textColor="@color/gym_text_primary"
            android:textSize="18sp"
            android:layout_marginTop="28dp" />
        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFuerza"
                style="@style/Widget.GymMate.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil_fuerza"
                />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipHipertrofia"
                style="@style/Widget.GymMate.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil_hipertrofia"
                />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipAcondicionamiento"
                style="@style/Widget.GymMate.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil_acondicionamiento"
                />
        </com.google.android.material.chip.ChipGroup>

        <Button
            android:id="@+id/btnGuardarPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/gym_lime"
            android:text="@string/btn_guardar_continuar"
            android:textColor="@color/black" />


    </LinearLayout>

</ScrollView>