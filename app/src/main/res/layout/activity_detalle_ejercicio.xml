<?xml version="1.0" encoding="utf-8"?>
<!--
    Detalle de ejercicio (ficha tecnica del RF5)

    Igual que el catalogo: LinearLayout vertical como raiz, con el contenido
    scrolleable arriba (height="0dp" + weight="1") y la barra de navegacion
    fija abajo. Si la barra estuviera DENTRO del ScrollView se iria hacia
    arriba al scrollear, y tiene que quedarse quieta.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gm_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">


            <!-- Fila de volver. Sin logo a proposito: en una pantalla
                 interna el logo ocupa ~68dp y no aporta nada, el usuario
                 ya sabe en que app esta. La flecha SI hace falta: es la
                 unica forma de volver al catalogo. -->
            <ImageView
                android:id="@+id/btnVolver"
                android:layout_width="54dp"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/volver"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/gm_text" />

            <TextView
                android:id="@+id/nombreEjercicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gm_text"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                tools:text="Press de Banca" />

            <!-- Chips de musculos. Son informativos, NO se tocan:
                 por eso android:clickable="false" y sin ChipGroup
                 con singleSelection. Van dentro de un ChipGroup igual,
                 para que se acomoden solos y pasen de linea si no entran. -->

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMusculoPrincipal"
                    style="@style/Widget.GymMate.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:clickable="false"
                    tools:text="Pecho (Principal)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMusculosSecundarios"
                    style="@style/Widget.GymMate.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:clickable="false"
                    tools:text="Triceps y Hombros" />

            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaGif"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/gm_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/gifEjercicio"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/detalle_ver_gif" />

            </com.google.android.material.card.MaterialCardView>
            <!-- ===================== INSTRUCCIONES ===================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detalle_instrucciones"
                android:textColor="@color/gm_text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detalle_guia"
                android:textColor="@color/gm_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <!-- UN SOLO TextView para TODOS los pasos.
                 Cada ejercicio trae una cantidad distinta de instrucciones
                 (2, 3, 6...), asi que no sirve tener TextViews fijos.
                 Java une la lista que viene de la API con saltos de linea
                 y la mete aca de una sola vez. -->
            <TextView
                android:id="@+id/instruccionesPasos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/gm_text"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp"
                android:layout_marginTop="12dp"
                tools:text="1. Apoya la espalda, gluteos y pies firmemente en el suelo y banco.\n2. Baja la barra de forma controlada hasta la altura del pecho.\n3. Empuja la barra hacia arriba con fuerza sin despegar los hombros." />

            <!-- ===================== CONSEJO ===================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detalle_consejo"
                android:textColor="@color/gm_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/gm_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/gm_stroke"
                app:strokeWidth="1dp"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_error"
                        app:tint="@color/gm_primary"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/consejoTecnico"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gm_text"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        tools:text="Evita rebotar la barra en el pecho y manten los codos a 45 grados." />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Barra inferior: una linea, definida en view_bottom_nav.xml -->
    <include layout="@layout/view_bottom_nav" />

</LinearLayout>
