<?xml version="1.0" encoding="utf-8"?>
<!--
    HOME - pantalla principal

    Misma estructura que catalogo y detalle: contenido scrolleable arriba
    (height="0dp" + weight="1") y la barra de navegacion fija abajo.

    Casi todo el contenido es dinamico: el saludo, la fecha, los dias
    completados, la rutina de hoy, el ultimo entrenamiento y los numeros.
    Por eso casi todos los textos van con tools:text y con id: @string es
    solo para los rotulos fijos ("Resumen semanal", "Datos Rapidos"...).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gm_background"
    tools:theme="@style/Theme.GymMate">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- ==================== CABECERA ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/saludo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gm_text"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        tools:text="Hola, Juan" />

                    <TextView
                        android:id="@+id/fechaHoy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gm_text_secondary"
                        android:textSize="15sp"
                        tools:text="Viernes, 25 de septiembre" />

                </LinearLayout>

                <!-- ####################################################
                     ## NUEVO: foto de perfil                          ##
                     ##                                                ##
                     ## En el mockup hay un avatar redondo. Un         ##
                     ## ImageView comun es cuadrado; para recortarlo   ##
                     ## en circulo hace falta ShapeableImageView (de   ##
                     ## Material) o Glide con una transformacion.      ##
                     ## Por ahora queda el circulo gris de placeholder.##
                     #################################################### -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <View
                        android:id="@+id/avatarUsuario"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_dia_pendiente" />

                    <include
                        layout="@layout/view_logo_gymmate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ==================== RESUMEN SEMANAL ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_resumen"
                android:textColor="@color/gm_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_progreso_semana"
                android:textColor="@color/gm_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">

                <!-- Los circulos son VARIABLES: dependen de los dias que el
                     usuario configuro en su perfil (pueden ser 3, 4 o 6).
                     Java va a vaciar este contenedor y generar uno por dia.
                     Los 4 de abajo son de ejemplo para poder maquetar. -->
                <LinearLayout
                    android:id="@+id/contenedorDias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_dia_completado"
                        android:gravity="center"
                        android:textColor="@color/gm_on_primary"
                        android:textStyle="bold"
                        tools:text="L" />

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_dia_completado"
                        android:gravity="center"
                        android:textColor="@color/gm_on_primary"
                        android:textStyle="bold"
                        tools:text="M" />

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_dia_pendiente"
                        android:gravity="center"
                        android:textColor="@color/gm_text_secondary"
                        tools:text="J" />

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_dia_pendiente"
                        android:gravity="center"
                        android:textColor="@color/gm_text_secondary"
                        tools:text="V" />

                </LinearLayout>

                <TextView
                    android:id="@+id/diasCompletados"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:textColor="@color/gm_text"
                    android:textSize="15sp"
                    tools:text="2 de 4 dias completados" />

            </LinearLayout>

            <!-- ==================== HOY TOCA ENTRENAR ==================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/gm_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:contentPadding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_hoy_toca"
                        android:textColor="@color/gm_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/rutinaDeHoy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gm_text"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp"
                        tools:text="Dia 1: Torso" />

                    <TextView
                        android:id="@+id/detalleRutinaHoy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gm_text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp"
                        tools:text="Pecho, espalda, hombros y brazos - 6 ejercicios" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmpezarEntrenamiento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/home_empezar"
                        android:textColor="@color/gm_on_primary"
                        app:backgroundTint="@color/gm_primary"
                        app:icon="@drawable/ic_play_arrow"
                        app:iconTint="@color/gm_on_primary"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== ULTIMO ENTRENAMIENTO ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_ultimo"
                android:textColor="@color/gm_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaUltimoEntrenamiento"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/gm_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/ultimoEntrenamiento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/gm_text"
                            android:textSize="17sp"
                            tools:text="Ayer - Pierna" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_schedule"
                                app:tint="@color/gm_text_secondary"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/duracionUltimo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:textColor="@color/gm_text_secondary"
                                android:textSize="13sp"
                                tools:text="52 min" />

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="14dp"
                                android:src="@drawable/ic_weight"
                                app:tint="@color/gm_text_secondary"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tonelajeUltimo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:textColor="@color/gm_text_secondary"
                                android:textSize="13sp"
                                tools:text="4.200 kg levantados" />

                        </LinearLayout>

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/gm_primary"
                        android:contentDescription="@null" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== DATOS RAPIDOS ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_datos_rapidos"
                android:textColor="@color/gm_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp" />

            <!-- Dos tarjetas al 50%: 0dp + weight="1" en cada una.
                 Mismo reparto que los 3 campos del perfil. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/gm_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:contentPadding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_fire"
                            app:tint="@color/gm_primary"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/home_racha"
                                android:textColor="@color/gm_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/valorRacha"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/gm_text"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                tools:text="3 semanas" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    app:cardBackgroundColor="@color/gm_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:contentPadding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_weight"
                            app:tint="@color/gm_primary"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/home_peso_actual"
                                android:textColor="@color/gm_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/valorPeso"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/gm_text"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                tools:text="78 kg" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Barra inferior: una linea, definida en view_bottom_nav.xml -->
    <include layout="@layout/view_bottom_nav" />

</LinearLayout>
