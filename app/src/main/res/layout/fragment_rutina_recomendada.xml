<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gm_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GymMate"
            android:textColor="@color/gm_text"
            android:textSize="18sp"
            android:textStyle="bold|italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Rutina Recomendada"
            android:textColor="@color/gm_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Basada en tu perfil de entrenamiento"
            android:textColor="@color/gm_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvResumenPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_chip_outline"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="Hipertrofia • 4 Días • Intermedio"
            android:textColor="@color/gm_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvNombreRutina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:text="TORSO / PIERNA"
            android:textColor="@color/gm_primary"
            android:textSize="36sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="4"
            tools:listitem="@layout/item_dia_rutina" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAsignarRutina"
            style="@style/GM.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:text="ASIGNAR RUTINA" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="¿Prefieres armar tu propia rutina?"
            android:textColor="@color/gm_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCrearPersonalizada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="Crear personalizada"
            android:textColor="@color/gm_primary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>