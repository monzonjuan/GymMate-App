<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvDiaTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/gm_text"
        android:textSize="18sp"
        tools:text="Día 1: Torso" />

    <TextView
        android:id="@+id/tvDiaDetalle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/gm_text_secondary"
        android:textSize="12sp"
        tools:text="Pecho, espalda, hombros y brazos • 6 ejercicios • 3-4 series" />
</LinearLayout>