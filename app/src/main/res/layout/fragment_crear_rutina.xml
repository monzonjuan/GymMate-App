<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gm_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnVolver"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="GymMate"
                android:textColor="@color/gm_text"
                android:textSize="18sp"
                android:textStyle="bold|italic" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp"
            android:gravity="center"
            android:text="Crear Rutina"
            android:textColor="@color/gm_text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de la rutina"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/gm_primary"
            app:hintTextColor="@color/gm_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombreRutina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:text="Mi Rutina de Fuerza"
                android:textColor="@color/gm_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Días de entrenamiento"
            android:textColor="@color/gm_text"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/dayL" style="@style/GM.Day.Selected"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_marginHorizontal="3dp" android:layout_weight="1" android:text="L" />
            <TextView android:id="@+id/dayM" style="@style/GM.Day"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_marginHorizontal="3dp" android:layout_weight="1" android:text="M" />
            <TextView android:id="@+id/dayMi" style="@style/GM.Day.Selected"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_marginHorizontal="3dp" android:layout_weight="1" android:text="Mi" />
            <TextView android:id="@+id/dayJ" style="@style/GM.Day"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_marginHorizontal="3dp" android:layout_weight="1" android:text="J" />
            <TextView android:id="@+id/dayV" style="@style/GM.Day.Selected"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_marginHorizontal="3dp" android:layout_weight="1" android:text="V" />
            <TextView android:id="@+id/dayS" style="@style/GM.Day"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_marginHorizontal="3dp" android:layout_weight="1" android:text="S" />
            <TextView android:id="@+id/dayD" style="@style/GM.Day"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_marginHorizontal="3dp" android:layout_weight="1" android:text="D" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Ejercicios"
            android:textColor="@color/gm_text_secondary"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEjercicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="2"
            tools:listitem="@layout/item_ejercicio_editable" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnadirEjercicio"
            style="@style/GM.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Añadir Ejercicio"
            app:icon="@drawable/ic_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarRutina"
            style="@style/GM.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:text="GUARDAR RUTINA" />
    </LinearLayout>
</ScrollView>