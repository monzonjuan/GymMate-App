<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gm_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp">


        <TextView
            android:id="@+id/tituloCatalogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/catalogo_titulo"
            android:textColor="@color/gm_text"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/contenedorBuscar"
            style="@style/Widget.GymMate.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/catalogo_buscar"
            app:startIconDrawable="@android:drawable/ic_menu_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoBuscar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:selectionRequired="true"
            app:singleSelection="true"
            app:checkedChip="@id/chipPecho">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPecho"
                style="@style/Widget.GymMate.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grupo_pecho" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEspalda"
                style="@style/Widget.GymMate.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grupo_espalda" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPiernas"
                style="@style/Widget.GymMate.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grupo_piernas" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHombros"
                style="@style/Widget.GymMate.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grupo_hombros" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBrazos"
                style="@style/Widget.GymMate.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grupo_brazos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAbdomen"
                style="@style/Widget.GymMate.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grupo_abdomen" />

        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaEjercicios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_ejercicio" />

    <include layout="@layout/view_bottom_nav" />

</LinearLayout>
